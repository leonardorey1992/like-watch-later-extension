{
  "manifest_version": 3,
  "name": "Add to Playlist",
  "version": "1.1",
  "description": "Adds a one-click 'Add to <your playlist>' item to every YouTube video's 3-dot menu.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content_script.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Extension Options",
    "default_popup": "options.html"
  }
}
